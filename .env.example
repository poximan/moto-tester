# Conexion PLC Modbus/TCP
MODBUS_HOST=10.10.9.122
MODBUS_PORT=502
MODBUS_UNIT_ID=10
MODBUS_TIMEOUT_S=2.0
MODBUS_RECONNECT_BACKOFF_S=1.0

# Polling
POLL_INTERVAL_MS=2000
POLL_MAX_STALE_MS=5000

# Desarrollo sin PLC
SIMULATION_MODE=false

# Acceso interno del servicio experto; los operadores ingresan sin login por edge-platform
INTERNAL_EMULATOR_TOKEN=FAKE_TOKEN_REEMPLAZAR

# Servicio experto de emulacion de campo
FIELD_EMULATOR_URL=http://field-emulator:8090
FIELD_EMULATOR_INTERVAL_MS=1000
FIELD_EMULATOR_INLET_OPEN_PCT=50
FIELD_EMULATOR_OUTLET_OPEN_PCT=50
FIELD_EMULATOR_INLET_RATE_PER_S=1.0
FIELD_EMULATOR_OUTLET_RATE_PER_S=1.0
FIELD_EMULATOR_PUMP_RATE_PER_S=1.0
